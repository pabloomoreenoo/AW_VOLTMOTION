<!DOCTYPE html>
<html lang="es">
<%- include('partials/head') %>
<body>

<%- include('partials/header') %>

<main class="container" style="padding-top:2.5rem; padding-bottom:4rem; max-width:680px;">

    <div class="mb-4">
        <p class="vm-section-label">Tu cuenta</p>
        <h1 class="vm-section-title">Reserva tu vehículo</h1>
    </div>

    <div class="card" style="border-radius:var(--vm-radius-lg); padding:2rem;">
        <section id="reservas" aria-labelledby="titulo-reservas">
            <h2 id="titulo-reservas" class="visually-hidden">Formulario de reserva</h2>

            <form id="form-reserva" novalidate>

                <div class="mb-3">
                    <label for="nombre-reserva" class="form-label">Nombre y apellidos</label>
                    <input type="text" id="nombre-reserva" name="nombre"
                           class="form-control" required minlength="3">
                    <span class="error text-danger small" id="error-nombre" aria-live="polite"></span>
                </div>

                <div class="mb-3">
                    <label for="email-reserva" class="form-label">Correo electrónico</label>
                    <input type="email" id="email-reserva" name="email"
                           class="form-control" required>
                    <span class="error text-danger small" id="error-email" aria-live="polite"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label for="fecha-reserva-inicio" class="form-label">Fecha de inicio</label>
                        <input type="datetime-local" id="fecha-reserva-inicio"
                               name="fecha-reserva-inicio" class="form-control" required>
                    </div>
                    <div class="col-sm-6">
                        <label for="fecha-reserva-fin" class="form-label">Fecha de fin</label>
                        <input type="datetime-local" id="fecha-reserva-fin"
                               name="fecha-reserva-fin" class="form-control" required>
                    </div>
                </div>
                <span class="error text-danger small" id="error-fecha" aria-live="polite"></span>

                <hr class="my-4" style="border-color:var(--vm-border);">

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label for="vehiculo-marca" class="form-label">Marca</label>
                        <input id="vehiculo-marca" name="vehiculo-marca"
                               class="form-control" placeholder="Ej: Tesla">
                    </div>
                    <div class="col-sm-6">
                        <label for="vehiculo-modelo" class="form-label">Modelo</label>
                        <input id="vehiculo-modelo" name="vehiculo-modelo"
                               class="form-control" placeholder="Ej: Model 3">
                    </div>
                </div>

                <div class="mb-4">
                    <label for="vehiculo-matricula" class="form-label">Matrícula <span class="text-muted fw-normal">(opcional)</span></label>
                    <input id="vehiculo-matricula" name="vehiculo-matricula"
                           class="form-control" placeholder="1234-ABC">
                </div>

                <!-- Barra de progreso -->
                <div class="mb-4">
                    <div class="progress" style="height:6px; border-radius:4px;">
                        <div class="progress-bar"
                             id="form-progress"
                             role="progressbar"
                             style="width:0%; background:var(--vm-green);"
                             aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                    <p class="mt-2 mb-0 small text-muted" id="progress-text">Compleción del formulario: 0%</p>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-primary px-4">Enviar reserva</button>
                    <button type="button" class="btn btn-outline-secondary" id="btn-reset-reserva">
                        Limpiar
                    </button>
                </div>

            </form>
        </section>
    </div>

</main>

<%- include('partials/footer') %>

<!-- SCRIPTS -->
<script src="/js/api.js"></script>
<script src="/js/reservas-ui.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/accesibilidad-ui.js"></script>
</body>
</html>
