<!DOCTYPE html>
<html lang="en">
    <%- include('partials/head') %>
    <body>
        

        <%- include('partials/header') %>

        

        <section id="reservas" class="container mt-5" aria-labelledby="titulo-reservas">
            <h2 id="titulo-reservas" class="mb-4">Reserva tu vehículo</h2>

            <form id="form-reserva" novalidate>
                <!-- Nombre y apellidos -->
                <div class="mb-3">
                <label for="nombre-reserva" class="form-label-h1">Nombre y apellidos</label>
                <input type="text"
                        id="nombre-reserva"
                        name="nombre"
                        class="form-control"
                        required
                        minlength="3">
                <span class="error" id="error-nombre" aria-live="polite"></span>
                </div>

                <!-- Correo electrónico -->
                <div class="mb-3">
                <label for="email-reserva" class="form-label-h1">Correo electrónico</label>
                <input type="email"
                        id="email-reserva"
                        name="email"
                        class="form-control"
                        required>
                <span class="error" id="error-email" aria-live="polite"></span>
                </div>

                <!-- Fecha de reserva -->
                <div class="mb-3">
                <label for="fecha-reserva-inicio" class="form-label-h1">Fecha de reserva(inicio)</label>
                <input type="datetime-local"
                        id="fecha-reserva-inicio"
                        name="fecha-reserva-inicio"
                        class="form-control"
                        required>
                <span class="error" id="error-fecha" aria-live="polite"></span>
                </div>

                <!-- Fecha de reserva -->
                <div class="mb-3">
                <label for="fecha-reserva-fin" class="form-label-h1">Fecha de reserva(fin)</label>
                <input type="datetime-local"
                        id="fecha-reserva-fin"
                        name="fecha-reserva-fin"
                        class="form-control"
                        required>
                <span class="error" id="error-fecha" aria-live="polite"></span>
                </div>

                <!-- Datos del vehículo (si no existe tabla vehiculos) -->
                <div class="mb-3">
                <label for="vehiculo-marca" class="form-label-h1">Marca</label>
                <input id="vehiculo-marca" name="vehiculo-marca" class="form-control" placeholder="Ej: Tesla">
                </div>

                <div class="mb-3">
                <label for="vehiculo-modelo" class="form-label-h1">Modelo</label>
                <input id="vehiculo-modelo" name="vehiculo-modelo" class="form-control" placeholder="Ej: Model 3">
                </div>

                <div class="mb-3">
                <label for="vehiculo-matricula" class="form-label-h1">Matrícula (opcional)</label>
                <input id="vehiculo-matricula" name="vehiculo-matricula" class="form-control" placeholder="1234-ABC">
                </div>

                <!-- Barra de progreso -->
                <div class="mb-3">
                <div class="progress">
                    <div class="progress-bar"
                        id="form-progress"
                        role="progressbar"
                        style="width: 0%;"
                        aria-valuenow="0"
                        aria-valuemin="0"
                        aria-valuemax="100">
                    </div>
                </div>
                <p class="mt-2 mb-0 small text-muted" id="progress-text">
                    Compleción del formulario: 0%
                </p>
                </div>

                <!-- Botones -->
                <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary">Enviar reserva</button>
                <button type="button" class="btn btn-secondary" id="btn-reset-reserva">
                    Borrar formulario
                </button>
                </div>
            </form>
        </section>

        <%- include('partials/footer') %>

        <!-- SCRIPTS -->
        <script src="/js/api.js"></script>
        <script src="/js/reservas-ui.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
         <script src="/js/accesibilidad-ui.js"></script>
        </body>
</html>