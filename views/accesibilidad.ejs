<!DOCTYPE html>
<html lang="en">
    <%- include('partials/head') %>
    <body>
        

        <%- include('partials/header') %>

        
            <main class="container mt-4">
                <h1>Preferencias de accesibilidad</h1>
                <p>Ajusta el contraste, tamaño de fuente y navegación por teclado. Estas preferencias se guardarán y se aplicarán al iniciar sesión.</p>

                <div class="card">
                    <div class="card-body d-flex gap-3 align-items-center">
                    <div class="form-check form-switch me-4">
                        <input class="form-check-input" type="checkbox" id="access-contrast">
                        <label class="form-check-label" for="access-contrast">Alto contraste</label>
                    </div>

                    <div>
                        <label for="access-fontsize" class="form-label mb-0">Tamaño de fuente</label>
                        <select id="access-fontsize" class="form-select">
                        <option value="small">Pequeño</option>
                        <option value="normal" selected>Normal</option>
                        <option value="large">Grande</option>
                        </select>
                    </div>

                    <div class="form-check form-switch ms-4">
                        <input class="form-check-input" type="checkbox" id="access-keynav">
                        <label class="form-check-label" for="access-keynav">Navegación mejorada por teclado</label>
                    </div>
                    </div>

                    <div class="card-footer d-flex gap-2">
                    <button class="btn btn-primary" id="access-save">Guardar preferencias</button>
                    <button class="btn btn-outline-secondary" id="access-reset">Restablecer</button>
                    
                    </div>
                </div>
                <%- include('modals/infoAccesibilidad') %>
            </main>

        <%- include('partials/footer') %>

        <!-- SCRIPTS -->
        <script src="/js/api.js"></script>
        <script src="/js/accesibilidad-ui.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
        </body>
</html>