<!DOCTYPE html>
<html lang="en">
    <%- include('partials/head') %>
    <body>
        
        <%- include('partials/header') %>

        <main>
            <section class="hero position-relative" id="imagenFondo" style="overflow:hidden;">
                <img src="img/tesla_coche.jpg" class="d-block w-100" alt="coche electrico en ciudad">

                <!--vamos a meter un tono oscuro para mejorar la estetica-->
                <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0, 0, 0, 0.45)); pointer-events: none;"></div>

                <div class="container position-absolute top-50 start-50 translate-middle text-center text-white" style="pointer-events:auto;">
                    <h1 class="display-5 fw-bold mb-3">
                        Bienvenid@, <%= (user && user.nombre) ? user.nombre : 'usuario' %> 
                    </h1>
                
                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                        <a href="/vehiculos" class="btn btn-outline-light btn-lg px-4">Ver vehículos</a>
                        <a href="/reservas" class="btn btn-outline-light btn-lg px-4">Hacer reserva</a>
                        <a href="/miActividad" class="btn btn-outline-light btn-lg px-4">Ver mis reservas</a>
                        <a href="/accesibilidad" class="btn btn-outline-light btn-lg px-4">Preferencias accesibilidad</a>
                    </div>
                
                </div>
            </section>
        </main>

        <%- include('modals/reservaRealizada') %>

        <%- include('partials/footer') %>

        <!-- SCRIPTS -->
        <script src="/js/api.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/js/accesibilidad-ui.js"></script>
        </body>
</html>