<!DOCTYPE html>
<html lang="en">
    <%- include('partials/head') %>
    <body>
        
        <%- include('partials/header') %>

        <main>
            <section class="hero position-relative" id="imagenFondo" style="overflow:hidden;">
                <img src="img/tesla_coche.jpg" class="d-block w-100" alt="coche electrico en ciudad">

                <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0, 0, 0, 0.45)); pointer-events: none;"></div>

                <div class="position-absolute" 
                    style="top: 20px; right: 20px; z-index: 10; pointer-events:auto;">
                    <div class="bg-light text-dark rounded-circle d-flex align-items-center justify-content-center border border-4 border-white shadow-lg"
                        style="width: 70px; height: 70px; font-size: 2rem; font-weight: bold;">
                        <%= user && user.nombre ? user.nombre.charAt(0).toUpperCase() : 'U' %>
                    </div>
                </div>

                <div class="container position-absolute top-50 start-50 translate-middle text-center text-white" style="pointer-events:auto;">
                    <h1 class="display-5 fw-bold mb-3">
                        Bienvenid@, <%= (user && user.nombre) ? user.nombre : 'usuario' %> 
                    </h1>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                        <a href="/gestionVehiculos" class="btn btn-outline-light btn-lg px-4">Gestionar vehículos</a>
                        <a href="/gestionReservas" class="btn btn-outline-light btn-lg px-4">Gestionar reservas</a>
                        <a href="/gestionConcesionarios" class="btn btn-outline-light btn-lg px-4">Gestionar concesionarios</a>
                        <a href="/gestionUsuarios" class="btn btn-outline-light btn-lg px-4">Gestionar Usuarios</a>
                        <a href="/estadisticas" class="btn btn-outline-light btn-lg px-4">Ver estadisticas</a>
                    </div>
                </div>
            </section>

        </main>

        <%- include('partials/footer') %>

        <!-- SCRIPTS -->
        <script src="/js/api.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
        </body>
</html>