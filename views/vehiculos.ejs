<!DOCTYPE html>
<html lang="es">
<%- include('partials/head') %>
<body>

<%- include('partials/header') %>

<main class="container" style="padding-top:2.5rem; padding-bottom:3rem;">

    <div class="mb-4">
        <p class="vm-section-label">Catálogo</p>
        <h1 class="vm-section-title">Vehículos disponibles</h1>
    </div>

    <!-- Filtros -->
    <section aria-labelledby="filtro-title"
             class="card mb-5"
             style="border-radius:var(--vm-radius-lg); padding:1.5rem;">
        <h2 id="filtro-title" class="h6 fw-bold mb-3" style="color:var(--vm-gray-700);">
            Filtrar resultados
        </h2>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label for="select-concesionario" class="form-label">Concesionario</label>
                <select id="select-concesionario" class="form-select" aria-label="Seleccionar concesionario">
                    <option value="all">— Todos los concesionarios —</option>
                </select>
            </div>

            <div class="col-12 col-md-2">
                <label for="input-autonomia" class="form-label">Autonomía mínima (km)</label>
                <input id="input-autonomia" type="number" min="0" step="1"
                       class="form-control" placeholder="Ej: 200" aria-label="Autonomía mínima">
            </div>

            <div class="col-12 col-md-2">
                <label for="input-plazas" class="form-label">Plazas mínimas</label>
                <input id="input-plazas" type="number" min="1" step="1"
                       class="form-control" placeholder="Ej: 4" aria-label="Plazas mínimas">
            </div>

            <div class="col-12 col-md-3">
                <label for="select-color" class="form-label">Color</label>
                <select id="select-color" class="form-select" aria-label="Seleccionar color">
                    <option value="">— Cualquiera —</option>
                </select>
            </div>

            <div class="col-12 col-md-2 d-grid gap-2">
                <button id="btn-filter" class="btn btn-primary">Aplicar filtros</button>
                <button id="btn-reset-filters" class="btn btn-outline-secondary">Borrar filtros</button>
            </div>
        </div>
    </section>

    <!-- Resultados -->
    <section aria-live="polite" id="vehiculos-container">
        <div id="vehiculos-grid" class="row gy-4"></div>
        <div id="vehiculos-empty" class="text-center py-5" hidden>
            <p class="text-muted fs-5">No se han encontrado vehículos con esos filtros.</p>
        </div>
    </section>

</main>

<%- include('partials/footer') %>

<!-- SCRIPTS -->
<script src="/js/api.js"></script>
<script src="/js/vehiculos-ui.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/accesibilidad-ui.js"></script>
</body>
</html>
